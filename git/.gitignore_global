# Global gitignore — OS and editor junk only.
# Install: git config --global core.excludesfile ~/.gitignore_global
# Keep build artifacts, logs, archives, etc. in per-project .gitignore files so
# legitimately tracked files (*.sql migrations, *.jar, *.log fixtures) aren't hidden.

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes

# Windows
Thumbs.db
ehthumbs.db
desktop.ini

# Editors / IDEs
.vscode/
.idea/
*.iml
*.sublime-workspace
*.swp
*.swo
*~

# Local env / secrets
.env.local
